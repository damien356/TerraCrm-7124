# Environment
NODE_ENV=development
WEBSITE_URL=http://localhost:3000
APPLICATION_ID=

# Better Auth - Configuration
BETTER_AUTH_SECRET=

# Database (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=

# Marketing email (Resend) - sending only, team@ marketing mail
RESEND_API_KEY=

# Marketing SMS (ClickSend)
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
# Alpha tag for one-way texts, e.g. "TerraFloors". Send-only.
CLICKSEND_SENDER_ID=
# ClickSend's own "APPROVED" is not the ACMA SMS Sender ID Register. An
# unregistered tag is overstamped "Unverified" on the handset, so leave this
# false until ACMA confirms registration.
CLICKSEND_TAG_ACMA_REGISTERED=false
# Dedicated AU mobile number, $20.90/mo, inbound free. Two-way, so replies and
# STOP opt-outs come back. Used only for steps that invite a reply. Never
# printed or advertised anywhere, 1300 1 TERRA is the public number.
CLICKSEND_REPLY_NUMBER=
